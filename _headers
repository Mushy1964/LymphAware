/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; font-src 'self' data:; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://checkout.stripe.com

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/portal/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/profile/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/profile-v2/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/sign-in/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/forgot-password/*
